# Copy to services/auth-service/.env. Compose loads it into the auth-service
# container; values set in docker-compose.yml take precedence over this file.
#
# Google OAuth client. The placeholders let the service start in development;
# Google sign-in works only with real credentials, and the service refuses to
# start with these placeholders when ENVIRONMENT=production.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
