# Optional. Copy to services/api-gateway/.env to change these; Compose loads the
# file into the api-gateway container, and values set in docker-compose.yml
# take precedence over it.
#
# Per-IP limit for login, register, refresh and exchange (requests per minute).
# Fails closed if Redis is unavailable.
RATE_LIMIT_AUTH_RPM=10
# Domain attribute of the refresh cookie; empty means the request host.
AUTH_COOKIE_DOMAIN=
