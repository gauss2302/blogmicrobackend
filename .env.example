# Copy to .env for local Compose runs. Use real secret values outside source control.
#
# Every `replace-with-*` value below is a placeholder. They are long enough to
# pass the services' length checks, so the services refuse to start when
# ENVIRONMENT=production while any of them is still in place. This file sets
# development so a local copy boots; production fails fast instead of running
# on credentials that are public in this repository.

ENVIRONMENT=development
LOG_LEVEL=info

# Service-to-service transport:
# - mesh: app gRPC stays plaintext inside an mTLS mesh/private network
# - app_mtls: Go gRPC clients/servers use GRPC_TLS_* certificates directly;
#   requires GRPC_TLS_ENABLED=true, GRPC_TLS_REQUIRE_CLIENT_CERT=true and the
#   CA, cert and key files, otherwise the services refuse to start
SERVICE_TRANSPORT_SECURITY=mesh
INTERNAL_HTTP_TRUST_MODE=private_network

GRPC_TLS_ENABLED=false
GRPC_TLS_CA_FILE=
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
GRPC_TLS_REQUIRE_CLIENT_CERT=false
GRPC_REFLECTION_ENABLED=false

POSTGRES_USER_PASSWORD=replace-with-user-db-password
POSTGRES_POST_PASSWORD=replace-with-post-db-password
POSTGRES_NOTIFICATION_PASSWORD=replace-with-notification-db-password

REDIS_PASSWORD=replace-with-redis-password
REDIS_DB=0

RABBITMQ_USER=replace-with-rabbitmq-user
RABBITMQ_PASSWORD=replace-with-rabbitmq-password
RABBITMQ_VHOST=replace-with-rabbitmq-vhost
RABBITMQ_EXCHANGE=microservices_events
# Binding key of the notification queue. post-service publishes post.created,
# post.updated and post.deleted; a narrower key silently drops the others.
RABBITMQ_ROUTING_KEY=post.*
RABBITMQ_QUEUE_NOTIFICATIONS=post_notifications
RABBITMQ_DLX=blog_events.dlx
RABBITMQ_DLQ=post_notifications_dlq
RABBITMQ_DLQ_ROUTING_KEY=post.failed
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_RECONNECT_DELAY=5
RABBITMQ_MAX_RETRIES=3

# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are not read from this file: Compose
# does not pass them on. Set them in services/auth-service/.env (copy
# services/auth-service/.env.example).
GOOGLE_REDIRECT_URL=https://api.example.com/api/v1/auth/google/callback
GOOGLE_DEFAULT_WEB_REDIRECT_URI=https://app.example.com/auth/callback
GOOGLE_ALLOWED_WEB_REDIRECT_URIS=https://app.example.com/auth/callback
GOOGLE_ALLOWED_MOBILE_REDIRECT_URIS=myapp://auth/callback
GOOGLE_ALLOWED_DOMAINS=

# Shared signing secret. auth-service signs access tokens with it; user-service,
# post-service and notification-service verify the tokens presented to their HTTP
# APIs with it. Compose passes this one value to all four, so they cannot drift.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=168
JWT_ISSUER=auth-service

API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
POST_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
# Next.js frontend (public). Talks to the gateway server-side via BACKEND_API_URL.
FRONTEND_PORT=3000

SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30
SERVER_IDLE_TIMEOUT=60
REQUEST_MAX_BODY_BYTES=1048576
# Per-client rate limiting. The gateway limits by client IP, but browsers reach
# it through the frontend BFF, so by default every user shares one bucket.
# Only when a reverse proxy that overwrites X-Forwarded-For sits in front of the
# frontend: set BFF_TRUSTED_PROXY_HOPS to the number of such proxies and
# TRUSTED_PROXIES to the address the gateway sees the frontend under. Without
# such a proxy leave both as they are: the header would be client-supplied and
# anyone could pick their own bucket.
TRUSTED_PROXIES=
BFF_TRUSTED_PROXY_HOPS=0

RATE_LIMIT_RPM=100
RATE_LIMIT_BURST=20
# The stricter per-IP limit for login, register, refresh and exchange is
# RATE_LIMIT_AUTH_RPM (default 10). Compose does not pass it from this file;
# set it in services/api-gateway/.env (copy services/api-gateway/.env.example).
RATE_LIMIT_ENABLED=true

# Browser origins of the web client. The gateway also rejects refresh and
# logout that carry the refresh cookie from any other Origin.
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_EXPOSE_HEADERS=Content-Length,X-RateLimit-Limit,X-RateLimit-Remaining,X-RateLimit-Reset
CORS_ALLOW_CREDENTIALS=true

AUTH_REFRESH_TOKEN_COOKIE=true
AUTH_REFRESH_TOKEN_COOKIE_SAMESITE=Lax

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=60
DB_MIGRATION_PATH=./migrations

KAFKA_BROKERS=kafka:9092
KAFKA_SASL_USERNAME=app
KAFKA_SASL_PASSWORD=Replace-with-kafka-1@
KAFKA_TOPIC_POSTS=search.posts
KAFKA_TOPIC_USERS=search.users
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=Replace-with-opensearch-1@
KAFKA_RETRY_BACKOFF_MS=500

NOTIFICATION_CLEANUP_DAYS=30
NOTIFICATION_BATCH_SIZE=100

# --- Monitoring (Prometheus + Grafana, started with `make infra-up`) ---
# Host ports (defaults match docker-compose). Prometheus scrapes app metrics on internal service ports;
# if you change HTTP ports below, update monitoring/prometheus/prometheus.yml targets.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-production

# search-service exposes gRPC on 50054 and a separate metrics/health HTTP server (default 9095).
SEARCH_SERVICE_METRICS_HTTP_PORT=9095
